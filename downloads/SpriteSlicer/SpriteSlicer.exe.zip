    union
    {
        FfxFloat32      f;
        FfxUInt32 u;
    } bits;

    bits.f       = f;
    FfxUInt32 u = bits.u;
    FfxUInt32 i = u >> 23;
    return (FfxUInt32)(base[i]) + ((u & 0x7fffff) >> shift[i]);
}













FFX_STATIC FfxUInt32 packHalf2x16(FfxFloat32x2 a)
{
    return f32tof16(a[0]) + (f32tof16(a[1]) << 16);
}
